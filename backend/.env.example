# Meu Ponto — backend
# Copie para .env e preencha. NUNCA commitar o .env preenchido.

PORT=3333
DATABASE_URL="postgresql://user:password@localhost:5432/meuponto?schema=public"

# Senha padrão para o primeiro acesso/recuperação
DEFAULT_PASSWORD="sua_senha_padrao_de_8_digitos"

# Chaves VAPID para Web Push Notifications
# Rode "node -e \"console.log(require('web-push').generateVAPIDKeys())\"" na pasta backend para gerar.
VAPID_PUBLIC_KEY="coloque_sua_chave_publica_aqui"
VAPID_PRIVATE_KEY="coloque_sua_chave_privada_aqui"
