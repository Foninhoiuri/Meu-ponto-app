# Meu Ponto — variáveis da stack (docker-compose / Portainer)
# Copie para .env e preencha. NUNCA commite o .env preenchido.
# Em produção, defina estes valores nas variáveis da Stack do Portainer.

# ── OBRIGATÓRIAS ───────────────────────────────────────────────
# Senha do PostgreSQL. Sem valor, o container do banco RECUSA INICIAR.
DB_PASSWORD=

# Senha inicial do usuário criado no primeiro boot.
# Sem valor, o backend sobe sem senha padrão definida.
DEFAULT_PASSWORD=

# ── WEB PUSH (necessárias p/ notificações persistirem) ────────
# Sem estas, o backend gera chaves EFÊMERAS e as inscrições de push quebram a
# cada restart do container. Gere uma vez com (na pasta backend):
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# A privada é SEGREDO — defina nas variáveis da Stack do Portainer, não em arquivo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do remetente das notificações (padrão: mailto:admin@meuponto.com)
VAPID_SUBJECT=

# ── OPCIONAIS (têm padrão) ─────────────────────────────────────
# Tag das imagens no GHCR. Padrão `latest`. Para VOLTAR uma versão, aponte para
# a versão ou o commit publicado pelo workflow `build` (ex.: 1.0.0 ou 6007978).
IMAGE_TAG=latest
DB_USER=postgres
DB_NAME=meuponto
BACKEND_PORT=3333
FRONTEND_PORT=8081
# Origem(ns) permitida(s) no CORS em produção (separe por vírgula). Vazio = libera geral.
WEB_ORIGIN=

