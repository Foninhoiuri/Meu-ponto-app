# Meu Ponto — variáveis da stack (docker-compose / Portainer)
# Copie para .env e preencha. NUNCA commite o .env preenchido.
# Em produção, defina estes valores direto na Stack do Portainer.

# --- Banco de Dados ---
DB_USER=postgres
DB_PASSWORD=
DB_NAME=meuponto

# --- Backend ---
BACKEND_PORT=3333
DEFAULT_PASSWORD=

# --- Frontend ---
FRONTEND_PORT=80

# --- Domínio (roteamento pelo Traefik) ---
APP_HOST=ponto.seudominio.com.br
